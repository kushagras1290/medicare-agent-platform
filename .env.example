# Local synthetic demo defaults. Replace every secret outside local development.
ENVIRONMENT=local
DATABASE_URL=sqlite:///./data/medicare.db
# For staging/production, prefer *_FILE values backed by a managed secret mount.
DATABASE_URL_FILE=
SERVICE_API_KEY=replace-with-at-least-32-random-characters
SERVICE_API_KEY_FILE=
PREVIOUS_SERVICE_API_KEYS=
REVIEWER_API_KEYS=reviewer-demo:replace-with-at-least-32-random-characters
REVIEWER_API_KEYS_FILE=
REVIEWER_AUTH_MODE=api_key
OIDC_ISSUER=
OIDC_AUDIENCE=
OIDC_JWKS_URL=
OIDC_REQUIRED_SCOPE=medicare:review
OIDC_REQUIRE_MFA=true
MODEL_GATEWAY_URL=http://127.0.0.1:8091
MODEL_GATEWAY_API_KEY=replace-with-at-least-32-random-characters
MODEL_GATEWAY_API_KEY_FILE=
MODEL_GATEWAY_TIMEOUT_SECONDS=15
MODEL_GATEWAY_MAX_RETRIES=2
CALLER_SERVICE_URL=http://127.0.0.1:8092
CALLER_SERVICE_API_KEY=replace-with-at-least-32-random-characters
CALLER_SERVICE_API_KEY_FILE=
CALLER_TIMEOUT_SECONDS=15
CALLER_MAX_RETRIES=2
CALLER_MAX_ATTEMPTS=5
API_INTERNAL_URL=http://127.0.0.1:8000
WORKER_POLL_SECONDS=5
AUTOMATION_BATCH_SIZE=20
ALLOW_REAL_PATIENT_DATA=false
ALLOW_LIVE_DISPATCH=false
REQUIRE_HUMAN_REVIEW=true
RELEASE_APPROVALS_PATH=
RELEASE_APPROVALS_SHA256=
RETENTION_DAYS=365
ALLOWED_HOSTS=127.0.0.1,localhost,testserver
ENFORCE_HTTPS=false

# Used only by the separate model gateway when MODEL_GATEWAY_MODE=openai.
MODEL_GATEWAY_MODE=stub
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# The included caller service is deliberately mock-only. A real telephony adapter
# requires approved consent, provider contracts and a separate reviewed implementation.
CALLER_MODE=mock
CALLER_PROVIDER_URL=
CALLER_PROVIDER_API_KEY_FILE=
CALLER_PROVIDER_TIMEOUT_SECONDS=20
